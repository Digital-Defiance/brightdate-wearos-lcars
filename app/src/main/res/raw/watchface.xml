<?xml version="1.0"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <UserConfigurations>
        <!-- In Wear OS WFF, colors can be referenced by index.
             .0 = Main accents (Top bar, inner C, some pills, fraction)
             .1 = Deep accents (Bottom bar, main label, some pills)
             .2 = Pop accents (Dedicated warm/contrast accent)
        -->
        <ColorConfiguration id="themeColor"
            displayName="@string/theme_label"
            defaultValue="lcars">

            <ColorOption id="lcars" displayName="@string/theme_lcars" colors="#ffcc99cc #ff9999ff #ffff9900" />
            <ColorOption id="tng_ops" displayName="@string/theme_tng_ops" colors="#ffdd4444 #ffffaa33 #ffffddbb" />
            <ColorOption id="voyager" displayName="@string/theme_voyager" colors="#ff44aaff #ff4466aa #ffffaa44" />
            <ColorOption id="ds9" displayName="@string/theme_ds9" colors="#ff9955aa #ffaa4444 #ffffaa00" />
            <ColorOption id="nemesis" displayName="@string/theme_nemesis" colors="#ff6688aa #ff444455 #ff88aacc" />
            <ColorOption id="picard" displayName="@string/theme_picard" colors="#ffcc3333 #ff882222 #ffcccccc" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff0d0823">

        <!-- ==================== LCARS Elbow Backbone ==================== -->
        <!-- 1. Outer Elbow Shape (Main Accent) -->
        <Group name="elbow_outer" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.0]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <RoundRectangle x="10" y="60" width="200" height="330" cornerRadiusX="50" cornerRadiusY="50">
                    <Fill color="#ffffffff" />
                </RoundRectangle>
            </PartDraw>
        </Group>

        <!-- 2. Masks to cut out the inner and right parts of the Elbow -->
        <PartDraw x="0" y="0" width="450" height="450">
            <!-- Inner cutout to create the "C" thickness -->
            <RoundRectangle x="40" y="90" width="200" height="270" cornerRadiusX="20" cornerRadiusY="20">
                <Fill color="#ff0d0823" />
            </RoundRectangle>
            <!-- Right mask to cleanly slice the elbow off -->
            <Rectangle x="130" y="0" width="320" height="450">
                <Fill color="#ff0d0823" />
            </Rectangle>
        </PartDraw>

        <!-- ==================== Starfield ==================== -->
        <!-- Placed after masks so stars aren't cut out by the background masks -->
        <Group name="starfield" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Ellipse x="22"  y="22"  width="4" height="4"><Fill color="#80ffffff" /></Ellipse>
                <Ellipse x="97"  y="37"  width="5" height="5"><Fill color="#66ffffff" /></Ellipse>
                <Ellipse x="240" y="30"  width="4" height="4"><Fill color="#99ffffff" /></Ellipse>
                <Ellipse x="390" y="18"  width="4" height="4"><Fill color="#b3ffffff" /></Ellipse>
                <Ellipse x="423" y="52"  width="3" height="3"><Fill color="#59ffffff" /></Ellipse>
                <Ellipse x="30"  y="390" width="4" height="4"><Fill color="#66ffffff" /></Ellipse>
                <Ellipse x="60"  y="346" width="3" height="3"><Fill color="#4cffffff" /></Ellipse>
                <Ellipse x="405" y="180" width="3" height="3"><Fill color="#4cffffff" /></Ellipse>
                <Ellipse x="416" y="405" width="4" height="4"><Fill color="#99ffffff" /></Ellipse>
                <Ellipse x="345" y="420" width="4" height="4"><Fill color="#66ffffff" /></Ellipse>
                <Ellipse x="240" y="400" width="3" height="3"><Fill color="#59ffffff" /></Ellipse>
                <Ellipse x="15"  y="200" width="3" height="3"><Fill color="#4cffffff" /></Ellipse>
            </PartDraw>
        </Group>

        <!-- ==================== Top Bars & Bottom Bars ==================== -->
        <!-- Top bar segments (Main Accent) with gap for text -->
        <Group name="top_bars" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.0]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Rectangle x="135" y="60" width="60" height="30">
                    <Fill color="#ffffffff" />
                </Rectangle>
                <Rectangle x="355" y="60" width="95" height="30">
                    <Fill color="#ffffffff" />
                </Rectangle>
            </PartDraw>
        </Group>

        <!-- Bottom bar (Deep Accent) -->
        <Group name="bottom_bar" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.1]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Rectangle x="135" y="360" width="315" height="30">
                    <Fill color="#ffffffff" />
                </Rectangle>
            </PartDraw>
        </Group>

        <!-- ==================== BRIGHTDATE label ==================== -->
        <!-- Nestled in the top bar cutout -->
        <Group name="title_label" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.1]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartText x="195" y="60" width="160" height="30">
                <Text align="CENTER">
                    <Font family="sans-serif-condensed" size="20" weight="BOLD" color="#ffffffff"><![CDATA[BRIGHTDATE]]></Font>
                </Text>
            </PartText>
        </Group>

        <!-- ==================== Sub-process Clutter (Corners) ==================== -->
        <!-- Top-right complication: steps by default, user-configurable -->
        <ComplicationSlot
            slotId="101"
            x="300" y="92" width="90" height="36"
            supportedTypes="SHORT_TEXT RANGED_VALUE"
            tintColor="[CONFIGURATION.themeColor.0]">
            <BoundingBox x="0" y="0" width="90" height="36" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="90" height="20">
                    <Text align="END">
                        <Font family="sans-serif-condensed-light" size="14" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="0" width="90" height="20">
                    <Text align="END">
                        <Font family="sans-serif-condensed-light" size="14" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom-right complication: battery % by default, user-configurable -->
        <ComplicationSlot
            slotId="102"
            x="300" y="332" width="90" height="36"
            supportedTypes="SHORT_TEXT RANGED_VALUE"
            tintColor="[CONFIGURATION.themeColor.2]">
            <BoundingBox x="0" y="0" width="90" height="36" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="8" width="90" height="20">
                    <Text align="END">
                        <Font family="sans-serif-condensed-light" size="14" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="8" width="90" height="20">
                    <Text align="END">
                        <Font family="sans-serif-condensed-light" size="14" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ==================== Functional Pills (Far Left) ==================== -->
        <Group name="pill_deep1" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.1]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <RoundRectangle x="50" y="160" width="30" height="15" cornerRadiusX="7" cornerRadiusY="7">
                    <Fill color="#ffffffff" />
                </RoundRectangle>
            </PartDraw>
        </Group>
        <!-- Pop Accent pill -->
        <Group name="pill_pop" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.2]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <RoundRectangle x="50" y="260" width="30" height="15" cornerRadiusX="7" cornerRadiusY="7">
                    <Fill color="#ffffffff" />
                </RoundRectangle>
            </PartDraw>
        </Group>
        <Group name="pill_main" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.0]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <RoundRectangle x="50" y="180" width="30" height="15" cornerRadiusX="7" cornerRadiusY="7">
                    <Fill color="#ffffffff" />
                </RoundRectangle>
            </PartDraw>
        </Group>
        <Group name="pill_large" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.1]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <RoundRectangle x="50" y="200" width="30" height="55" cornerRadiusX="7" cornerRadiusY="7">
                    <Fill color="#ffffffff" />
                </RoundRectangle>
            </PartDraw>
        </Group>

        <!-- ==================== Big integer: floor(BrightDate) ==================== -->
        <!-- Shifted right for functional asymmetry -->
        <Group name="integer_display" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartText x="80" y="150" width="310" height="150">
                <Text align="END">
                    <Font family="sans-serif-condensed" size="130" weight="BOLD" color="#ffffffff">
                        <Template>%d<Parameter expression="round(floor([MINUTES_SINCE_EPOCH] / 1440.0 - 10957.49919926))" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- ==================== .fraction: 5 digits ==================== -->
        <Group name="fraction_text" x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.themeColor.0]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartText x="80" y="290" width="310" height="60">
                <Text align="END">
                    <Font family="sans-serif-condensed" size="54" weight="BOLD" color="#ffffffff">
                        <Template>.%05d<Parameter expression="round(fract([MINUTES_SINCE_EPOCH] / 1440.0 - 10957.49919926) * 100000) % 100000" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

    </Scene>
</WatchFace>